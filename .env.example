# SRIBOGA SCADA - Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# Or use deploy_windows.bat to auto-generate .env

# --- Application ---
NODE_ENV=production
PORT=3001
JWT_SECRET=your-strong-random-secret-here

# --- PostgreSQL (User Authentication) ---
PGHOST=localhost
PGUSER=scada_user
PGPASSWORD=your_scada_user_password
PGDATABASE=scada_db

# --- MSSQL (Weighing Data) ---
MSSQL_SERVER=your-sql-server-ip
MSSQL_USER=sa
MSSQL_PASSWORD=your-sql-password
MSSQL_DATABASE=SFM Main
MSSQL_PORT=1433
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# --- SCADA Default Admin ---
SCADA_AUTO_SEED_ADMIN=true
SCADA_DEFAULT_ADMIN_USER=admin
SCADA_DEFAULT_ADMIN_PASSWORD=12345678
SCADA_DEFAULT_ADMIN_EMAIL=admin@scada.local

# --- OPC UA ---
OPCUA_AUTO_CONNECT=true

# --- SQL Auto-Reconnect ---
SCADA_SQL_AUTO_CONNECT=true

# --- Sensor Configuration ---
SENSOR_WEIGHT_CAPTURE_DELAY_MS=100
SENSOR_MIN_GAP_MS=1500
MIN_VALID_GROSS_KG=1
ZEROING_CAPTURE_DELAY_MS=500
